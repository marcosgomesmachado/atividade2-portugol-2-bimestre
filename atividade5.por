programa
{
	
	funcao inicio()
	{
		inteiro temp
		
		escreva("Informe a temperatura: ")
		leia(temp)
		
		se (temp < 0)
		
		{
			
			escreva("\n\n", "A temperatura é negativa")
			
		}

		senao

		{

			escreva("\n\n", "A temperatura é positiva", "\n")
			
		}
	}
}
